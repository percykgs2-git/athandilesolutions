## Frontend build variables (must be prefixed VITE_ to be exposed to the browser bundle).
## These are the same public Supabase project values used to initialize the client
## in src/integrations/supabase/client.ts. The publishable key is safe to expose;
## it is not a secret.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

## Server-side secrets used by Supabase Edge Functions (e.g. send-contact-email).
## Do NOT put these in this file for local frontend dev — they are not read by Vite
## and must never be prefixed VITE_. Set them on Supabase instead:
##   supabase secrets set MAILGUN_API_KEY=your-key MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_BASE_URL=https://api.mailgun.net
